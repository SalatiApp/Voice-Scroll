<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_add_alias_title"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewAliasPhrase"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@color/bg_dark_elevated"
        android:hint="@string/hint_alias_word"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/target_command_label"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerTargetCommand"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/bg_dark_elevated" />

</LinearLayout>
